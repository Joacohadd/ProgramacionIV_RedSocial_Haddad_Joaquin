MONGODB_URI=mongodb://127.0.0.1:27017/trama_tp2
MONGODB_DB=trama_tp2
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=
PORT=3000
PUBLIC_API_URL=http://localhost:3000
FRONTEND_ORIGIN=http://127.0.0.1:4200,http://localhost:4200
IMAGE_STORAGE=local
# Para publicar con Cloudinary, usar IMAGE_STORAGE=cloudinary y configurar estas variables:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
FRONTEND_URL=http://localhost:4200
# Para probar en localhost sin SMTP: el enlace se guarda en .password-reset-dev-link.txt.
PASSWORD_RESET_DEV_LOG=false
# Para enviar correos reales, configurar un servidor SMTP y dejar PASSWORD_RESET_DEV_LOG=false.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Trama <no-reply@example.com>
